<!-- Reglas propias Wazuh — van en el MANAGER: /var/ossec/etc/rules/local_rules.xml -->
<!-- Validar if_sid con: sudo /var/ossec/bin/wazuh-logtest  (31100 Apache access, 86601 Suricata eve, 554 syscheck nuevo archivo, 5763 fuerza bruta sshd) -->
<group name="tiendacr,web,">
  <rule id="100100" level="3">
    <if_sid>31100</if_sid>
    <url>/vulnerabilities/brute/</url>
    <description>TiendaCR: intento de login en la app</description>
  </rule>
  <rule id="100101" level="10" frequency="8" timeframe="60">
    <if_matched_sid>100100</if_matched_sid>
    <same_source_ip />
    <description>TiendaCR: fuerza bruta al login de la app desde $(srcip)</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failures,</group>
  </rule>
</group>
<group name="tiendacr,suricata,">
  <rule id="100200" level="12">
    <if_sid>86601</if_sid>
    <field name="alert.signature_id">^100000[235]$</field>
    <description>TiendaCR: ataque web por regla propia de Suricata: $(alert.signature)</description>
    <mitre><id>T1190</id></mitre>
  </rule>
</group>
<group name="tiendacr,syscheck,">
  <rule id="100300" level="12">
    <if_sid>554</if_sid>
    <field name="file">^/opt/tiendacr/uploads</field>
    <description>TiendaCR: archivo nuevo en uploads (posible webshell): $(file)</description>
    <mitre><id>T1505.003</id></mitre>
  </rule>
</group>
