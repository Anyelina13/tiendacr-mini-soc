#!/usr/bin/env bash
# Copia este archivo a scripts/env.sh (IGNORADO por git) y completa los valores.
# NUNCA subas scripts/env.sh al repositorio.
export LAB_NET="192.168.56"
export IP_KALI="${LAB_NET}.10"
export IP_WEB="${LAB_NET}.20"
export IP_SIEM="${LAB_NET}.30"
export IP_HOST="${LAB_NET}.1"
export ADMIN_USER="soc"                 # usuario admin de las VMs Ubuntu
export SSH_KEY="$HOME/.ssh/tiendacr_ed25519"
export VBOX_HOSTONLY="vboxnet0"
export UBUNTU_ISO="$HOME/isos/ubuntu-24.04.3-live-server-amd64.iso"
export KALI_OVA="$HOME/isos/kali-linux-2025.x-virtualbox-amd64.ova"
# Hash de respaldo para consola (generar con: openssl passwd -6):
export PW_HASH="__PON_AQUI_UN_HASH__"
# --- Sustitucion de Kali por un atacante Ubuntu (misma IP .10) ---
export ATK_USER="soc"                   # usuario de la VM atacante
# --- Windows / VBoxManage unattended ---
export ADMIN_PW="CambiaEsta_1"          # clave del usuario soc en las VMs (consola)
export HOSTONLY_ADAPTER="VirtualBox Host-Only Ethernet Adapter"   # nombre en Windows
export VBM="/c/Program Files/Oracle/VirtualBox/VBoxManage.exe"
